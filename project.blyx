use std::cli;
use console;
use bowerbird;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Decide whether a proposed numeric-core dependency upgrade fits a declared version range.");
        println!("Usage: bowerbird installed candidate lower upper");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = bowerbird_upgrade([1, 2, 9], [1, 10, 0], [1, 0, 0], [2, 0, 0]);
    } else {
        if count != 4 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let installed = console_vector(args_at(argv, 0));
        let candidate = console_vector(args_at(argv, 1));
        let lower = console_vector(args_at(argv, 2));
        let upper = console_vector(args_at(argv, 3));
        result = bowerbird_upgrade(installed, candidate, lower, upper);
    }
    if len(result) == 0 { stderr_line("Invalid input for Bowerbird. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}

use vendor::bowerbird::bowerbird;

fn main() {
    let installed = [1, 2, 9];
    let candidate = [1, 10, 0];
    let lower = [1, 0, 0];
    let upper = [2, 0, 0];
    let result = bowerbird_upgrade(installed, candidate, lower, upper);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
